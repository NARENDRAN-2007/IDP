# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*

# Database (Supabase or PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_db
# Set to 'memory' to force in-memory PostgreSQL engine for tests/offline
USE_IN_MEMORY_DB_IF_DISCONNECTED=true

# Redis Configuration (BullMQ timer trigger)
REDIS_URL=redis://localhost:6379
USE_IN_MEMORY_REDIS_IF_DISCONNECTED=true

# JWT Authentication
JWT_SECRET=emergency-hospital-access-secret-token-key-2026
JWT_REFRESH_SECRET=emergency-hospital-refresh-secret-token-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenRouteService (Optional)
ORS_API_KEY=
